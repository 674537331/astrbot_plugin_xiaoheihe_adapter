{
  "profiles": {
    "type": "template_list",
    "description": "小黑盒账号档案",
    "hint": "当前版本正式支持单账号运行；结构和存储均按 profile_id 隔离。凭证独立保存在插件数据目录。",
    "templates": {
      "account": {
        "name": "账号档案",
        "display_item": "profile_id",
        "hide_hint_in_list": true,
        "items": {
          "profile_id": {
            "description": "档案 ID",
            "type": "string",
            "default": "default",
            "hint": "仅允许字母、数字、下划线和短横线；须与机器人页面适配器的 profile_id 一致。"
          },
          "display_name": {
            "description": "显示名称",
            "type": "string",
            "default": "默认账号"
          },
          "enabled": {
            "description": "启用档案",
            "type": "bool",
            "default": true
          },
          "poll_mentions": {
            "description": "轮询 @ 通知",
            "type": "bool",
            "default": true
          },
          "poll_replies": {
            "description": "轮询评论回复",
            "type": "bool",
            "default": true
          },
          "dry_run": {
            "description": "模拟运行（仅生成，不发送）",
            "type": "bool",
            "default": true
          },
          "owner_uid": {
            "description": "主人小黑盒 UID",
            "type": "string",
            "default": ""
          }
        }
      }
    },
    "default": [
      {
        "__template_key": "account",
        "profile_id": "default",
        "display_name": "默认账号",
        "enabled": true,
        "poll_mentions": true,
        "poll_replies": true,
        "dry_run": true,
        "owner_uid": ""
      }
    ]
  },
  "polling": {
    "type": "object",
    "description": "通知轮询",
    "items": {
      "poll_interval_seconds": {
        "description": "轮询间隔（秒）",
        "type": "int",
        "default": 60,
        "slider": {"min": 30, "max": 1800, "step": 5}
      },
      "poll_jitter_seconds": {
        "description": "轮询随机抖动（秒）",
        "type": "float",
        "default": 5.0
      },
      "max_pages_per_poll": {
        "description": "每类通知最大页数",
        "type": "int",
        "default": 3
      },
      "page_size": {
        "description": "单页通知数",
        "type": "int",
        "default": 20
      },
      "initial_backfill_count": {
        "description": "首次启动回溯条数",
        "type": "int",
        "default": 0,
        "hint": "默认 0：首次成功轮询记录当前最新 message_id，之后接收新通知。"
      }
    }
  },
  "providers": {
    "type": "object",
    "description": "模型 Provider",
    "items": {
      "llm_provider_id": {
        "description": "固定 LLM Provider",
        "type": "string",
        "default": "",
        "_special": "select_provider",
        "hint": "小黑盒主 Agent 的首选 Provider；无效时本轮退回 AstrBot 主模型，留空跟随当前配置。"
      },
      "image_provider_id": {
        "description": "固定图片 Provider",
        "type": "string",
        "default": "",
        "_special": "select_provider",
        "hint": "图片理解首选 Provider；失败时依次尝试 AstrBot 默认图片转述模型和当前主模型。"
      },
      "context_provider_id": {
        "description": "上下文压缩 Provider",
        "type": "string",
        "default": "",
        "_special": "select_provider",
        "hint": "用于长楼层语义压缩；留空时复用固定 LLM，再留空则跟随当前会话 Provider。"
      }
    }
  },
  "context": {
    "type": "object",
    "description": "上下文与图片",
    "items": {
      "max_post_chars": {"description": "帖子正文最大字符数", "type": "int", "default": 6000},
      "max_thread_comments": {"description": "楼层最大评论数", "type": "int", "default": 40},
      "thread_reply_post_chars": {
        "description": "楼层回复时原帖正文字符预算",
        "type": "int",
        "default": 1600,
        "hint": "长楼层压缩未触发、关闭或失败时的确定性兜底预算。"
      },
      "thread_reply_recent_comments": {
        "description": "楼层回复时最近对话条数",
        "type": "int",
        "default": 12,
        "hint": "长楼层压缩未触发、关闭或失败时的确定性兜底窗口。"
      },
      "enable_thread_reply_compression": {
        "description": "启用长楼层 LLM 语义压缩",
        "type": "bool",
        "default": true
      },
      "thread_reply_compression_trigger_chars": {
        "description": "楼层压缩触发字符数",
        "type": "int",
        "default": 2400
      },
      "thread_reply_compressed_post_chars": {
        "description": "压缩后原帖摘要字符上限",
        "type": "int",
        "default": 700
      },
      "thread_reply_compressed_comments_chars": {
        "description": "压缩后最近楼层摘要字符上限",
        "type": "int",
        "default": 1400
      },
      "thread_reply_compressed_image_chars": {
        "description": "被动回复原帖图片/缓存描述字符上限",
        "type": "int",
        "default": 800
      },
      "thread_reply_compression_timeout_seconds": {
        "description": "上下文压缩超时秒数",
        "type": "int",
        "default": 30
      },
      "context_cache_ttl_seconds": {
        "description": "上下文缓存 TTL",
        "type": "int",
        "default": 60
      },
      "context_cache_max_entries": {
        "description": "上下文缓存最大条目",
        "type": "int",
        "default": 256
      },
      "enable_image_understanding": {
        "description": "启用图片理解",
        "type": "bool",
        "default": true
      },
      "max_images_per_event": {
        "description": "每事件最大图片数",
        "type": "int",
        "default": 6
      },
      "image_timeout_seconds": {
        "description": "单图视觉处理时间基数",
        "type": "int",
        "default": 15
      },
      "image_total_timeout_seconds": {
        "description": "单事件视觉处理总预算（秒）",
        "type": "int",
        "default": 240
      }
    }
  },
  "reply": {
    "type": "object",
    "description": "回复策略",
    "items": {
      "dry_run_mark_processed": {
        "description": "模拟运行后标记完成",
        "type": "bool",
        "default": true
      },
      "max_reply_chars": {"description": "最大回复字符数", "type": "int", "default": 500},
      "reply_timeout_seconds": {"description": "回复生成超时", "type": "int", "default": 120},
      "provider_fallback_grace_seconds": {
        "description": "主模型回退宽限（秒）",
        "type": "int",
        "default": 60
      },
      "max_retries": {"description": "安全请求最大重试次数", "type": "int", "default": 3},
      "only_explicit_mentions": {"description": "只回复明确 @", "type": "bool", "default": true},
      "reply_to_direct_replies": {
        "description": "回复别人对机器人评论的直接回复",
        "type": "bool",
        "default": true
      }
    }
  },
  "permissions": {
    "type": "object",
    "description": "身份与过滤",
    "items": {
      "whitelist_mode": {"description": "启用用户白名单模式", "type": "bool", "default": false},
      "user_whitelist": {"description": "用户 UID 白名单", "type": "list", "default": [], "items": {"type": "string"}},
      "user_blacklist": {"description": "用户 UID 黑名单", "type": "list", "default": [], "items": {"type": "string"}},
      "author_whitelist": {"description": "帖子作者 UID 白名单", "type": "list", "default": [], "items": {"type": "string"}},
      "author_blacklist": {"description": "帖子作者 UID 黑名单", "type": "list", "default": [], "items": {"type": "string"}},
      "keyword_blacklist": {"description": "关键词黑名单", "type": "list", "default": [], "items": {"type": "string"}},
      "map_owner_to_astrbot_admin": {
        "description": "将主人映射为 AstrBot 管理员",
        "type": "bool",
        "default": false,
        "hint": "高风险选项，默认关闭。"
      }
    }
  },
  "network": {
    "type": "object",
    "description": "网络、并发和重试",
    "items": {
      "request_timeout_seconds": {"description": "请求总超时", "type": "int", "default": 20},
      "connect_timeout_seconds": {"description": "连接超时", "type": "int", "default": 8},
      "read_timeout_seconds": {"description": "读取超时", "type": "int", "default": 15},
      "min_request_interval_seconds": {"description": "最小请求间隔", "type": "float", "default": 1.0},
      "max_reply_concurrency": {"description": "最大回复并发", "type": "int", "default": 2},
      "max_pending_events": {"description": "待处理事件硬上限", "type": "int", "default": 50},
      "max_pending_per_user": {"description": "单用户待处理上限", "type": "int", "default": 5}
    }
  },
  "proactive_feed": {
    "type": "object",
    "description": "主动刷帖（高风险）",
    "items": {
      "enabled": {"description": "启用主动刷帖", "type": "bool", "default": false},
      "dry_run": {
        "description": "主动帖子模拟运行（仅生成，不发送）",
        "type": "bool",
        "default": true,
        "hint": "关闭后进入真实发送流程；是否需要人工确认由 review_required 决定。"
      },
      "review_required": {
        "description": "真实发送前要求人工审核",
        "type": "bool",
        "default": true,
        "hint": "高风险：与模拟运行同时关闭时，AI 生成的主动回复会直接发布到小黑盒。"
      },
      "interval_seconds": {"description": "运行间隔", "type": "int", "default": 900},
      "jitter_seconds": {"description": "每轮附加随机抖动", "type": "int", "default": 60},
      "max_per_run": {"description": "每轮主动 AI 请求上限", "type": "int", "default": 1},
      "max_per_day": {
        "description": "每日主动 AI 请求上限",
        "type": "int",
        "default": 10,
        "hint": "仅在合格帖子提交给 AI 前计数；浏览和本地过滤不占额度。"
      },
      "source": {
        "description": "旧版推荐流分类（仅迁移）",
        "type": "string",
        "default": "all",
        "invisible": true,
        "hint": "v1.2.x 兼容字段。v1.3.0 启动后迁移到 fallback_sources，不再作为当前设置入口。"
      },
      "topic_ids": {
        "description": "真实分区 ID（由浏览来源页管理）",
        "type": "list",
        "default": [],
        "invisible": true,
        "items": {"type": "string"}
      },
      "fallback_sources": {
        "description": "兼容/回退推荐流分类（由浏览来源页管理）",
        "type": "list",
        "default": ["all"],
        "invisible": true,
        "items": {"type": "string"}
      },
      "keywords": {"description": "允许关键词", "type": "list", "default": [], "items": {"type": "string"}},
      "allowed_post_types": {
        "description": "允许的帖子类型（空列表表示不限制）",
        "type": "list",
        "default": [],
        "items": {"type": "string"}
      }
    }
  },
  "retention": {
    "type": "object",
    "description": "数据保留与上限",
    "items": {
      "incoming_body_days": {"description": "通知正文保留天数", "type": "int", "default": 30},
      "dry_run_days": {"description": "模拟运行正文保留天数", "type": "int", "default": 30},
      "failed_days": {"description": "失败事件保留天数", "type": "int", "default": 30},
      "success_reply_days": {"description": "成功回复记录保留天数", "type": "int", "default": 90},
      "session_mapping_days": {"description": "会话映射保留天数", "type": "int", "default": 180},
      "dedup_days": {"description": "去重记录保留天数", "type": "int", "default": 365},
      "database_warn_mb": {"description": "数据库警告阈值 MB", "type": "int", "default": 150},
      "database_soft_limit_mb": {"description": "数据库软上限 MB", "type": "int", "default": 200},
      "log_total_limit_mb": {"description": "日志总上限 MB", "type": "int", "default": 100}
    }
  },
  "logging": {
    "type": "object",
    "description": "日志",
    "items": {
      "level": {
        "description": "日志级别",
        "type": "string",
        "default": "INFO",
        "options": ["DEBUG", "INFO", "WARNING", "ERROR"]
      },
      "max_memory_entries": {"description": "内存日志条数", "type": "int", "default": 2000}
    }
  }
}
